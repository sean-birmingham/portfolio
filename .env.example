# Copy to .env.local for local development, and add the same keys in Vercel
# (Project → Settings → Environment Variables).

# Web3Forms access key for the contact form (get one free at web3forms.com).
# Without it the form is hidden and visitors see your email instead.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional: your custom domain, once you have one (e.g. https://seanbirmingham.dev).
# On Vercel the production URL is used automatically when this is empty.
NEXT_PUBLIC_SITE_URL=
